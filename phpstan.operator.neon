# Level max plus phpstan-strict-rules on the DEV-986 operator files,
# the DEV-985 kill-switch types, the queue manager, the webhook
# worker, and mcp_sentinel.module. CI requires this file after
# composer require phpstan/phpstan-strict-rules; extension-installer
# loads rules.neon, so this file must not include it again.
# Untouched 1.x code in McpKillSwitch.php and mcp_sentinel.install
# is recorded in phpstan.operator-baseline.neon from Tests
# 39110065729 on bff12db (those files were already in this scan).
# Module, queue-manager, and worker entries are the errors those
# files already had when they joined this scan. They are not a
# 1.x / pre-#318 claim: Tests 39115568856 was this PR, and
# 39110065729 did not scan the module. Hold-path reads go
# through McpStoredValue so the QueueManager cast.string
# bucket is not a #318 absorb.
# New DEV-985 code must not add baseline entries.
includes:
  - phpstan.operator-baseline.neon

parameters:
  level: max
  reportUnmatchedIgnoredErrors: true
  fileExtensions:
    - php
    - install
  paths:
    - src/Service/McpAnomalyEvidence.php
    - src/Service/McpAuditOperationQuery.php
    - src/Service/McpOperatorBindingUidSchema.php
    - src/Service/McpOperatorIdentityFactory.php
    - src/Service/McpPaladinIntrospection.php
    - src/Value/McpOperatorIdentity.php
    - src/Exception/McpKillSwitchException.php
    - src/Service/McpOperatorBinding.php
    - src/Drush/Commands/McpKillSwitchCommands.php
    - src/Service/McpKillSwitch.php
    - src/Service/McpWebhookQueueManager.php
    - src/Service/McpKillEnforcerInterface.php
    - src/Plugin/QueueWorker/McpWebhookWorker.php
    - src/Event/McpKillUnavailableConfirmerEvent.php
    - src/Enum/McpKillBlockStatus.php
    - src/Value/McpKillSwitchResult.php
    - src/Value/McpStoredValue.php
    - mcp_sentinel.install
    - mcp_sentinel.module
    - mcp_sentinel.api.php
  ignoreErrors:
    # Portable across Drupal 10.6 (int) and 11 (FetchAs). Same ignore as
    # phpstan.neon.dist. Scoped to the update hooks that still pass
    # PDO::FETCH_ASSOC.
    -
      identifier: argument.type
      message: '#fetchAll\(\) expects Drupal\\Core\\Database\\Statement\\FetchAs\|null, int given#'
      path: mcp_sentinel.install
