<?php

/**
 * @file
 * Counts unavailable-confirmer hook invocations for kernel tests.
 */

/**
 * Implements hook_mcp_sentinel_kill_unavailable_confirmer().
 */
function mcp_sentinel_kill_hook_probe_mcp_sentinel_kill_unavailable_confirmer(array $context): void {
  $GLOBALS['mcp_sentinel_kill_hook_probe'][] = $context;
  if (!empty($GLOBALS['mcp_sentinel_kill_hook_probe_throw'])) {
    throw new \RuntimeException('unavailable confirmer hook threw');
  }
}
