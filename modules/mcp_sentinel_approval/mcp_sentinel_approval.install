<?php

/**
 * @file
 * Install/update hooks for the MCP Sentinel Approval submodule.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\mcp_sentinel_approval\Service\McpBreakGlassManager;
use Drupal\user\RoleInterface;

/**
 * Implements hook_schema().
 */
function mcp_sentinel_approval_schema(): array {
  $schema['mcp_sentinel_manifest_used'] = [
    'description' => 'Consumed single-use idempotency keys for sealed manifests.',
    'fields' => [
      'idempotency_key' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'request_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'used' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['idempotency_key'],
  ];
  return $schema;
}

/**
 * Implements hook_requirements().
 *
 * Break-glass is only safe as a least-privilege, time-boxed role. Report
 * ERROR when the role is missing, is_admin, or holds permissions outside the
 * allowlist (same refuse conditions as McpBreakGlassManager::grant()). Report
 * WARNING when the role is a proper subset of the allowlist — safer elevation,
 * but the documented operator shell is incomplete.
 */
function mcp_sentinel_approval_requirements(string $phase): array {
  $requirements = [];
  // Install/update phases run before config and entities are reliable; only
  // assert the break-glass role posture at runtime.
  if ($phase !== 'runtime') {
    return $requirements;
  }

  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load(McpBreakGlassManager::ROLE_ID);
  // Entity storage is EntityInterface|null; RoleInterface is required for
  // isAdmin() / getPermissions() and for treating a non-role as "missing".
  if (!$role instanceof RoleInterface) {
    $requirements['mcp_sentinel_approval_mcp_admin_missing'] = [
      'title' => t('MCP Sentinel Approval: mcp_admin role missing'),
      'value' => t('Not found'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('The approval submodule expects a non-admin <code>mcp_admin</code> role for time-boxed break-glass grants. Import the optional config shipped with this module (or create an equivalent role limited to the break-glass allowlist). Break-glass grants are refused until the role exists.'),
    ];
    return $requirements;
  }

  // is_admin is incompatible with an enumerated least-privilege break-glass
  // set: Drupal grants every permission implicitly to is_admin roles.
  if ($role->isAdmin()) {
    $requirements['mcp_sentinel_approval_mcp_admin_is_admin'] = [
      'title' => t('MCP Sentinel Approval: mcp_admin is is_admin'),
      'value' => t('Unsafe'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('The <code>mcp_admin</code> role is flagged <code>is_admin</code>, so it holds every permission implicitly. Break-glass grants are refused. Clear <code>is_admin</code> and limit the role to the shipped break-glass allowlist. Do not put approve mcp sentinel operations on this role.'),
    ];
    // is_admin already implies every permission; skip set drift checks.
    return $requirements;
  }

  // Extras = role outgrew the elevation ceiling. Same severity as grant refuse.
  $extras = McpBreakGlassManager::permissionExtras($role);
  if ($extras !== []) {
    $requirements['mcp_sentinel_approval_mcp_admin_extra_permissions'] = [
      'title' => t('MCP Sentinel Approval: mcp_admin has extra permissions'),
      'value' => t('Unsafe'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('The <code>mcp_admin</code> role holds permissions outside the break-glass allowlist (@extras). Break-glass grants are refused until those are removed (or moved to a standing role). Allowlist: @allowlist.', [
        '@extras' => implode(', ', $extras),
        '@allowlist' => implode(', ', McpBreakGlassManager::ALLOWED_PERMISSIONS),
      ]),
    ];
  }

  // Missing shipped perms = incomplete operator shell. Narrower is safer, so
  // WARNING only; grant still succeeds on a proper subset.
  $missing = McpBreakGlassManager::permissionMissing($role);
  if ($missing !== []) {
    $requirements['mcp_sentinel_approval_mcp_admin_missing_permissions'] = [
      'title' => t('MCP Sentinel Approval: mcp_admin missing shipped permissions'),
      'value' => t('Incomplete'),
      'severity' => REQUIREMENT_WARNING,
      'description' => t('The <code>mcp_admin</code> role is missing shipped break-glass permissions (@missing). Elevation is narrower than the documented operator shell. Restore them from the optional config if operators need that shell during an incident.', [
        '@missing' => implode(', ', $missing),
      ]),
    ];
  }

  return $requirements;
}

/**
 * Install the mcp_admin_grant entity type for the break-glass model.
 */
function mcp_sentinel_approval_update_10001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('mcp_admin_grant') === NULL) {
    $type = \Drupal::entityTypeManager()->getDefinition('mcp_admin_grant');
    $manager->installEntityType($type);
    return 'Installed the mcp_admin_grant entity type (time-boxed break-glass grants).';
  }
  return 'The mcp_admin_grant entity type is already installed.';
}

/**
 * Add the sealed action-manifest field on approval requests.
 */
function mcp_sentinel_approval_update_10002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getFieldStorageDefinition('manifest', 'mcp_approval_request') !== NULL) {
    return 'The sealed action-manifest field is already installed.';
  }
  $definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Sealed action manifest'))
    ->setDescription(t('HMAC-sealed immutable action manifest. Empty when none was minted.'))
    ->setRequired(FALSE);
  $manager->installFieldStorageDefinition(
    'manifest',
    'mcp_approval_request',
    'mcp_sentinel_approval',
    $definition,
  );
  return 'Added the sealed action-manifest field on approval requests.';
}

/**
 * Install the consumed-manifest idempotency table.
 */
function mcp_sentinel_approval_update_10003(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('mcp_sentinel_manifest_used')) {
    return 'The manifest idempotency table is already installed.';
  }
  $spec = mcp_sentinel_approval_schema();
  $schema->createTable('mcp_sentinel_manifest_used', $spec['mcp_sentinel_manifest_used']);
  return 'Installed the consumed-manifest idempotency table.';
}
