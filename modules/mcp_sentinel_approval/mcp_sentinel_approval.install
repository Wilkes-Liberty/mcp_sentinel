<?php

/**
 * @file
 * Install/update hooks for the MCP Sentinel Approval submodule.
 */

declare(strict_types=1);

use Drupal\user\RoleInterface;

/**
 * Implements hook_requirements().
 *
 * Break-glass is only safe as a least-privilege, time-boxed role. If the role
 * is missing or is still is_admin, the site is not in the shipped posture —
 * report ERROR rather than letting operators discover it when a grant silently
 * means "everything".
 *
 * Mirrors McpBreakGlassManager::grant() fail-closed checks so the Status
 * report and the grant path agree.
 */
function mcp_sentinel_approval_requirements(string $phase): array {
  $requirements = [];
  // Install/update phases run before config and entities are reliable; only
  // assert the break-glass role posture at runtime.
  if ($phase !== 'runtime') {
    return $requirements;
  }

  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('mcp_admin');
  // Entity storage is EntityInterface|null; RoleInterface is required for
  // isAdmin() and for treating a non-role entity as "missing".
  if (!$role instanceof RoleInterface) {
    $requirements['mcp_sentinel_approval_mcp_admin_missing'] = [
      'title' => t('MCP Sentinel Approval: mcp_admin role missing'),
      'value' => t('Not found'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('The approval submodule expects a non-admin <code>mcp_admin</code> role for time-boxed break-glass grants. Import the optional config shipped with this module (or create an equivalent enumerated role). Break-glass grants are refused until the role exists.'),
    ];
    return $requirements;
  }

  // is_admin is incompatible with an enumerated least-privilege break-glass
  // set: Drupal grants every permission implicitly to is_admin roles.
  if ($role->isAdmin()) {
    $requirements['mcp_sentinel_approval_mcp_admin_is_admin'] = [
      'title' => t('MCP Sentinel Approval: mcp_admin is is_admin'),
      'value' => t('Unsafe'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('The <code>mcp_admin</code> role is flagged <code>is_admin</code>, so it holds every permission implicitly. Break-glass grants are refused. Clear <code>is_admin</code> and limit the role to the shipped break-glass set: access administration pages, view the administration theme, access site reports, view mcp sentinel audit log, administer mcp sentinel. Do not put approve mcp sentinel operations on this role.'),
    ];
  }

  return $requirements;
}

/**
 * Install the mcp_admin_grant entity type for the break-glass model.
 */
function mcp_sentinel_approval_update_10001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('mcp_admin_grant') === NULL) {
    $type = \Drupal::entityTypeManager()->getDefinition('mcp_admin_grant');
    $manager->installEntityType($type);
    return 'Installed the mcp_admin_grant entity type (time-boxed break-glass grants).';
  }
  return 'The mcp_admin_grant entity type is already installed.';
}
