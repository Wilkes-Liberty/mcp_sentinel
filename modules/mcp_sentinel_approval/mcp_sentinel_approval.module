<?php

/**
 * @file
 * Hook implementations for the MCP Sentinel Approval submodule.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\mcp_sentinel_approval\Service\McpBreakGlassManager;
use Drupal\user\RoleInterface;

/**
 * Implements hook_help().
 */
function mcp_sentinel_approval_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name !== 'help.page.mcp_sentinel_approval') {
    return '';
  }

  $settings_url = Url::fromRoute('mcp_sentinel_approval.settings')->toString();
  $approvals_url = Url::fromRoute('entity.mcp_approval_request.collection')->toString();
  $grants_url = Url::fromRoute('entity.mcp_admin_grant.collection')->toString();

  $output = '';
  $output .= '<h2>' . t('About') . '</h2>';
  $output .= '<p>' . t('MCP Sentinel Approval is an optional human-in-the-loop gate for the base module. When enabled, a governed <em>destructive</em> operation is not executed immediately — it is queued as an approval request for an authorized human to approve or deny. On approval the stored operation is replayed; on denial it is discarded. This adds a deliberate, audited checkpoint on top of the policy-profile gates.') . '</p>';

  $output .= '<h2>' . t('What it gates') . '</h2>';
  $output .= '<ul>';
  $output .= '<li>' . t('The operations you select on the <a href=":settings">approval settings</a> page — by default bulk <strong>delete</strong>, <strong>config write</strong> (config set/import), and <strong>module disable</strong>.', [':settings' => $settings_url]) . '</li>';
  $output .= '<li>' . t('Privilege escalation (<code>grant_mcp_admin</code> via <code>drush mcp-sentinel:break-glass</code>) is <strong>always</strong> gated, regardless of the settings, and results in a time-boxed grant that a cron reaper auto-revokes.') . '</li>';
  $output .= '</ul>';
  $output .= '<p>' . t('Enforcement uses a veto seam in the base module: a gated operation dispatches a destructive-operation event that this submodule vetoes to hold the operation. If this submodule is not enabled, nothing vetoes and operations run subject only to the policy-profile gates.') . '</p>';

  $output .= '<h2>' . t('Where to work') . '</h2>';
  $output .= '<ul>';
  $output .= '<li>' . t('<a href=":approvals">Approvals queue</a> — review, approve, or deny pending requests.', [':approvals' => $approvals_url]) . '</li>';
  $output .= '<li>' . t('<a href=":grants">Break-glass grants</a> — see who currently holds the time-boxed <code>mcp_admin</code> role and until when.', [':grants' => $grants_url]) . '</li>';
  $output .= '<li>' . t('<a href=":settings">Approval settings</a> — choose which operations require approval and set the break-glass grant lifetime.', [':settings' => $settings_url]) . '</li>';
  $output .= '</ul>';
  $output .= '<p>' . t('For the overall trust model and the base module, see the <a href=":help">MCP Sentinel help</a> and the project README.', [':help' => Url::fromRoute('help.page.mcp_sentinel')->toString()]) . '</p>';

  return $output;
}

/**
 * Implements hook_cron().
 *
 * Reaps expired time-boxed mcp_admin break-glass grants, then force-revokes
 * any still-active grants when the role's posture has become unsafe (missing,
 * is_admin, or allowlist extras). Cron-based revocation mirrors the
 * content-lock reaper and survives missed runs, where a delayed queue item
 * could be lost.
 */
function mcp_sentinel_approval_cron(): void {
  /** @var \Drupal\mcp_sentinel_approval\Service\McpBreakGlassManager $breakGlass */
  $breakGlass = \Drupal::service('mcp_sentinel_approval.break_glass');
  $breakGlass->reapExpired();
  $breakGlass->reapUnsafePosture();
}

/**
 * Implements hook_form_FORM_ID_alter() for user_role_form.
 *
 * Surfaces that mcp_admin is time-boxed break-glass with a fixed allowlist,
 * before the operator widens it in People → Roles and only learns later via
 * grant refuse or the Status report.
 */
function mcp_sentinel_approval_form_user_role_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!is_object($form_object) || !method_exists($form_object, 'getEntity')) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof RoleInterface || $entity->id() !== McpBreakGlassManager::ROLE_ID) {
    return;
  }

  $allowlist = McpBreakGlassManager::ALLOWED_PERMISSIONS;
  $status_url = Url::fromRoute('system.status')->toString();
  $items = array_map(static fn (string $p): string => '<code>' . htmlspecialchars($p, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</code>', $allowlist);

  $form['mcp_sentinel_break_glass_warning'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['messages', 'messages--warning'],
      'role' => 'status',
    ],
    '#weight' => -200,
    'title' => [
      '#markup' => '<p><strong>' . t('MCP Sentinel break-glass role') . '</strong></p>',
    ],
    'body' => [
      '#markup' => '<p>' . t('This role is the time-boxed <code>mcp_admin</code> break-glass elevation, not a standing admin role. Grants refuse and the <a href=":status">Status report</a> reports ERROR if it is flagged is_admin or holds any permission outside the shipped allowlist. A narrower subset still grants (Status report WARNING).', [':status' => $status_url]) . '</p>',
    ],
    'list_intro' => [
      '#markup' => '<p>' . t('Shipped allowlist (keep identical to <code>McpBreakGlassManager::ALLOWED_PERMISSIONS</code> and <code>config/optional/user.role.mcp_admin.yml</code>):') . '</p>',
    ],
    'list' => [
      '#theme' => 'item_list',
      '#items' => $items,
    ],
  ];
}
