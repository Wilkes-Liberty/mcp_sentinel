<?php

/**
 * @file
 * MCP Sentinel GraphQL governance.
 *
 * Applies field-level redaction and DLP value-pattern masking to GraphQL
 * Compose responses for MCP requests. Operation gating and audit live in
 * GraphqlGovernanceSubscriber; entity allow/deny is handled by
 * hook_entity_access in mcp_sentinel.module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\graphql\GraphQL\Execution\FieldContext;
use Drupal\graphql_compose\Plugin\GraphQLCompose\GraphQLComposeFieldTypeInterface;
use Drupal\mcp_sentinel\Enum\McpGovernedSurface;
use Drupal\mcp_sentinel\McpPolicyProfileInterface;
use Drupal\mcp_sentinel\Service\McpClassificationResolver;

/**
 * Implements hook_help().
 */
function mcp_sentinel_graphql_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name !== 'help.page.mcp_sentinel_graphql') {
    return '';
  }

  $output = '';
  $output .= '<h2>' . t('About') . '</h2>';
  $output .= '<p>' . t('MCP Sentinel GraphQL extends the base governance to a <a href=":gc">GraphQL Compose</a> endpoint. For governed MCP agents it applies the resolved policy profile to GraphQL responses: field-name redaction, DLP value-pattern masking, and exfiltration result-count caps, and it adds mutation gating and audit. Entity allow/deny is handled by the base module entity-access hook.', [':gc' => 'https://www.drupal.org/project/graphql_compose']) . '</p>';

  $output .= '<h2>' . t('Configuration') . '</h2>';
  $output .= '<p>' . t('This submodule has no settings of its own. It reads the same policy profiles and Data Loss Prevention settings as the base module: set <em>redacted fields</em> and gates per profile, and enable DLP, from the <a href=":settings">MCP Sentinel settings</a> and profile forms. Enabling this submodule is all that is required to bring GraphQL responses under governance.', [':settings' => Url::fromRoute('mcp_sentinel.settings')->toString()]) . '</p>';
  $output .= '<p>' . t('For the overall trust model, see the <a href=":help">MCP Sentinel help</a> and the project README.', [':help' => Url::fromRoute('help.page.mcp_sentinel')->toString()]) . '</p>';

  return $output;
}

/**
 * Implements hook_graphql_compose_field_results_alter().
 *
 * For governed MCP agents, this hook applies two passes in order:
 *
 * 1. Field-name redaction: fields listed in the resolved policy profile's
 *    redacted_fields list are replaced with '[REDACTED]'. A non-empty result
 *    is always preserved (even if the original was empty) so required
 *    single-value fields keep a value and do not trip GraphQL Compose's
 *    non-null guard.
 *
 * 2. DLP value-pattern masking (d.o #3617061): for fields that pass the
 *    name-redaction step, string values are scanned by the McpDlp service.
 *    A pattern may declare a classification label; a hit may tighten the
 *    response ceiling and is fully redacted when it exceeds the ceiling.
 *    It can never raise one. DLP is a no-op when dlp_enabled is FALSE.
 *
 * The 'user.roles' and 'oauth2_scopes' cache contexts are added so governed and
 * non-governed responses are cached separately.
 */
function mcp_sentinel_graphql_graphql_compose_field_results_alter(array &$results, mixed $entity, GraphQLComposeFieldTypeInterface $plugin, FieldContext $context): void {
  /** @var \Drupal\mcp_sentinel\Service\McpPolicyResolver $resolver */
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  $profile = $resolver->resolve();
  $redacted = $profile ? $profile->getRedactedFields() : [];

  // Responses vary by the governed OAuth agent channel — add both contexts so
  // a redacted/masked agent-channel value is never served to a cookie-session
  // request for the same user.
  $context->addCacheContexts(['user.roles', 'oauth2_scopes']);

  if (!$profile) {
    return;
  }

  // A resolved field on a live entity is a governed collection member.
  // Deduped entity_read rows feed the bulk-read anomaly signal (#3616612).
  if ($entity instanceof EntityInterface) {
    $readId = (string) ($entity->uuid() ?: $entity->id());
    \Drupal::service('mcp_sentinel.audit_logger')->logEntityRead(
      $entity->getEntityTypeId(),
      $readId,
      [
        'surface' => McpGovernedSurface::Graphql->value,
        'bundle' => $entity->bundle(),
      ],
    );
  }

  // Pass 1: field-name redaction (existing behaviour), then the classification
  // egress ceiling (d.o #3616540 part 2) — an over-ceiling field takes the
  // same placeholder, so labels only ever deny more.
  $redact = $redacted && in_array($plugin->getFieldName(), $redacted, TRUE);
  if (!$redact) {
    $redact = _mcp_sentinel_graphql_field_over_ceiling($entity, $plugin, $profile, $context);
  }
  if ($redact) {
    if ($results === []) {
      $results = ['[REDACTED]'];
      return;
    }
    foreach ($results as $delta => $value) {
      $results[$delta] = '[REDACTED]';
    }
    return;
  }

  // Pass 2: DLP value-pattern masking, classification-aware (d.o #3617061).
  // A labelled hit may tighten the request ceiling and is fully redacted
  // when it exceeds the ceiling in force; it can never raise one. Non-string
  // deltas are skipped — DLP cannot meaningfully scan them as a flat string.
  /** @var \Drupal\mcp_sentinel\Service\McpDlp $dlp */
  $dlp = \Drupal::service('mcp_sentinel.dlp');
  $classification = \Drupal::hasService('mcp_sentinel.classification')
    ? \Drupal::service('mcp_sentinel.classification')
    : NULL;
  $surface = McpGovernedSurface::Graphql;
  $ceiling = $classification?->effectiveCeiling($profile, $surface);
  foreach ($results as $delta => $value) {
    if (!is_string($value)) {
      continue;
    }
    if ($classification === NULL) {
      $results[$delta] = $dlp->scan($value);
      continue;
    }
    $context->addCacheContexts(McpClassificationResolver::CACHE_CONTEXTS);
    $egress = $dlp->applyForEgress($value, $ceiling, $classification);
    $results[$delta] = $egress->value();
    if ($egress->isDenied()) {
      $entity_type_id = '';
      $bundle = '';
      if ($entity instanceof EntityInterface) {
        $entity_type_id = $entity->getEntityTypeId();
        $bundle = (string) $entity->bundle();
      }
      $classification->evidence(
        $profile,
        $surface,
        $entity_type_id !== '' ? $entity_type_id : 'dlp',
        $bundle,
        $plugin->getFieldName(),
        (string) $egress->deniedLabel(),
        $ceiling ?? $classification->lowestLabel(),
      );
    }
    if ($classification->detectorCeiling() !== NULL) {
      $context->mergeCacheMaxAge(0);
      $ceiling = $classification->effectiveCeiling($profile, $surface);
    }
  }

  // Pass 3: exfiltration result-count cap.
  // Truncates multi-value field result lists to the profile's result_count_cap
  // (when > 0) so a governed agent cannot retrieve an unbounded list through
  // a GraphQL query. Truncation happens after redaction and DLP so those passes
  // always operate on the original (full) set. The agent observes fewer results
  // than requested; the truncation is also signalled via the cache context tag
  // on the field resolver context which carries the truncated flag.
  /** @var \Drupal\mcp_sentinel\Service\McpExfiltrationGuard $guard */
  $guard = \Drupal::service('mcp_sentinel.exfiltration_guard');
  [$capped, $truncated] = $guard->capResults($results, $profile);
  if ($truncated) {
    $results = $capped;
    // Surface truncation metadata via the cache-context tags so callers can
    // detect it; cache-context values here only affect cache keying, not
    // user-visible output, but they ensure a truncated response is never served
    // to a non-truncated (different-cap) profile request.
    $context->addCacheContexts(['user.roles', 'oauth2_scopes']);
  }
}

/**
 * Whether a GraphQL field's classification exceeds the profile's ceiling.
 *
 * The entity type and bundle come from the entity being resolved, or from the
 * plugin's field definition when the resolver passed none; without either
 * there is nothing to classify. Ceiling-dependent results vary by route and by
 * the caller's declared ceiling, and graphql_compose does not bubble field
 * access cacheability itself, so the contexts are added here.
 *
 * @param mixed $entity
 *   The entity being resolved, when the field plugin passes one.
 * @param \Drupal\graphql_compose\Plugin\GraphQLCompose\GraphQLComposeFieldTypeInterface $plugin
 *   The field plugin.
 * @param \Drupal\mcp_sentinel\McpPolicyProfileInterface $profile
 *   The resolved policy profile.
 * @param \Drupal\graphql\GraphQL\Execution\FieldContext $context
 *   The field context receiving cache contexts.
 *
 * @return bool
 *   TRUE when the field must be replaced with the redaction placeholder.
 */
function _mcp_sentinel_graphql_field_over_ceiling(mixed $entity, GraphQLComposeFieldTypeInterface $plugin, McpPolicyProfileInterface $profile, FieldContext $context): bool {
  if (!\Drupal::hasService('mcp_sentinel.classification')) {
    // Deploy window: the cached container predates the service.
    return FALSE;
  }
  /** @var \Drupal\mcp_sentinel\Service\McpClassificationResolver $classification */
  $classification = \Drupal::service('mcp_sentinel.classification');
  if (!$classification->assignsAboveLowest()) {
    return FALSE;
  }
  if ($entity instanceof EntityInterface) {
    $entity_type_id = $entity->getEntityTypeId();
    $bundle = $entity->bundle();
  }
  else {
    $definition = $plugin->getFieldDefinition();
    if ($definition === NULL) {
      return FALSE;
    }
    $entity_type_id = $definition->getTargetEntityTypeId();
    $bundle = $definition->getTargetBundle();
  }
  $context->addCacheContexts(McpClassificationResolver::CACHE_CONTEXTS);
  // This alter only ever runs inside GraphQL execution, so the surface is
  // known here without consulting the request.
  $surface = McpGovernedSurface::Graphql;
  $ceiling = $classification->effectiveCeiling($profile, $surface);
  $label = $classification->labelForField($entity_type_id, $bundle, $plugin->getFieldName());
  if ($ceiling === NULL || !$classification->exceeds($label, $ceiling)) {
    return FALSE;
  }
  $classification->evidence($profile, $surface, $entity_type_id, (string) $bundle, $plugin->getFieldName(), $label, $ceiling);
  return TRUE;
}
