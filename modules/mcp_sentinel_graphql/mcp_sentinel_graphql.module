<?php

/**
 * @file
 * MCP Sentinel GraphQL governance.
 *
 * Applies field-level redaction and DLP value-pattern masking to GraphQL
 * Compose responses for MCP requests. Operation gating and audit live in
 * GraphqlGovernanceSubscriber; entity allow/deny is handled by
 * hook_entity_access in mcp_sentinel.module.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\graphql\GraphQL\Execution\FieldContext;
use Drupal\graphql_compose\Plugin\GraphQLCompose\GraphQLComposeFieldTypeInterface;

/**
 * Implements hook_help().
 */
function mcp_sentinel_graphql_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name !== 'help.page.mcp_sentinel_graphql') {
    return '';
  }

  $output = '';
  $output .= '<h2>' . t('About') . '</h2>';
  $output .= '<p>' . t('MCP Sentinel GraphQL extends the base governance to a <a href=":gc">GraphQL Compose</a> endpoint. For governed MCP agents it applies the resolved policy profile to GraphQL responses: field-name redaction, DLP value-pattern masking, and exfiltration result-count caps, and it adds mutation gating and audit. Entity allow/deny is handled by the base module entity-access hook.', [':gc' => 'https://www.drupal.org/project/graphql_compose']) . '</p>';

  $output .= '<h2>' . t('Configuration') . '</h2>';
  $output .= '<p>' . t('This submodule has no settings of its own. It reads the same policy profiles and Data Loss Prevention settings as the base module: set <em>redacted fields</em> and gates per profile, and enable DLP, from the <a href=":settings">MCP Sentinel settings</a> and profile forms. Enabling this submodule is all that is required to bring GraphQL responses under governance.', [':settings' => Url::fromRoute('mcp_sentinel.settings')->toString()]) . '</p>';
  $output .= '<p>' . t('For the overall trust model, see the <a href=":help">MCP Sentinel help</a> and the project README.', [':help' => Url::fromRoute('help.page.mcp_sentinel')->toString()]) . '</p>';

  return $output;
}

/**
 * Implements hook_graphql_compose_field_results_alter().
 *
 * For governed MCP agents, this hook applies two passes in order:
 *
 * 1. Field-name redaction: fields listed in the resolved policy profile's
 *    redacted_fields list are replaced with '[REDACTED]'. A non-empty result
 *    is always preserved (even if the original was empty) so required
 *    single-value fields keep a value and do not trip GraphQL Compose's
 *    non-null guard.
 *
 * 2. DLP value-pattern masking (V1 scope): for fields that pass the name-
 *    redaction step, string values are scanned by the McpDlp service for
 *    configured PII patterns (email, phone, SSN, credit-card, custom). Matches
 *    are either fully redacted or partially masked depending on the
 *    dlp_mask_mode setting. DLP is a no-op when dlp_enabled is FALSE (opt-in).
 *
 * The 'user.roles' and 'oauth2_scopes' cache contexts are added so governed and
 * non-governed responses are cached separately.
 */
function mcp_sentinel_graphql_graphql_compose_field_results_alter(array &$results, mixed $entity, GraphQLComposeFieldTypeInterface $plugin, FieldContext $context): void {
  /** @var \Drupal\mcp_sentinel\Service\McpPolicyResolver $resolver */
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  $profile = $resolver->resolve();
  $redacted = $profile ? $profile->getRedactedFields() : [];

  // Responses vary by the governed OAuth agent channel — add both contexts so
  // a redacted/masked agent-channel value is never served to a cookie-session
  // request for the same user.
  $context->addCacheContexts(['user.roles', 'oauth2_scopes']);

  if (!$profile) {
    return;
  }

  // Pass 1: field-name redaction (existing behaviour).
  if ($redacted && in_array($plugin->getFieldName(), $redacted, TRUE)) {
    if ($results === []) {
      $results = ['[REDACTED]'];
      return;
    }
    foreach ($results as $delta => $value) {
      $results[$delta] = '[REDACTED]';
    }
    return;
  }

  // Pass 2: DLP value-pattern masking (V1: GraphQL output only).
  // Only applies when DLP is enabled and there are string values to scan.
  // Non-string deltas (objects, arrays, booleans) are skipped — they are
  // complex types that DLP cannot meaningfully scan as a flat string.
  /** @var \Drupal\mcp_sentinel\Service\McpDlp $dlp */
  $dlp = \Drupal::service('mcp_sentinel.dlp');
  foreach ($results as $delta => $value) {
    if (is_string($value)) {
      $results[$delta] = $dlp->scan($value);
    }
  }

  // Pass 3: exfiltration result-count cap.
  // Truncates multi-value field result lists to the profile's result_count_cap
  // (when > 0) so a governed agent cannot retrieve an unbounded list through
  // a GraphQL query. Truncation happens after redaction and DLP so those passes
  // always operate on the original (full) set. The agent observes fewer results
  // than requested; the truncation is also signalled via the cache context tag
  // on the field resolver context which carries the truncated flag.
  /** @var \Drupal\mcp_sentinel\Service\McpExfiltrationGuard $guard */
  $guard = \Drupal::service('mcp_sentinel.exfiltration_guard');
  [$capped, $truncated] = $guard->capResults($results, $profile);
  if ($truncated) {
    $results = $capped;
    // Surface truncation metadata via the cache-context tags so callers can
    // detect it; cache-context values here only affect cache keying, not
    // user-visible output, but they ensure a truncated response is never served
    // to a non-truncated (different-cap) profile request.
    $context->addCacheContexts(['user.roles', 'oauth2_scopes']);
  }
}
