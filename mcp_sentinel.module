<?php

/**
 * @file
 * MCP Sentinel companion module.
 *
 * Provides security presets, audit logging, content locks, and HMAC webhooks
 * for MCP-connected Drupal sites.
 */

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function mcp_sentinel_help(string $route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.mcp_sentinel':
      $settings_url = Url::fromRoute('mcp_sentinel.settings')->toString();
      $audit_url = Url::fromRoute('mcp_sentinel.audit_log')->toString();
      $output = '';
      $output .= '<h2>' . t('About') . '</h2>';
      $output .= '<p>' . t('MCP Sentinel is a governance layer for Drupal sites exposed to AI agents over the Model Context Protocol (MCP), JSON:API, and GraphQL. It does not connect any agent itself; it sits in front of the request stack and enforces what an agent may read, write, or delete, records a tamper-evident audit trail of every governed change, and adds operational controls (rate limits, exfiltration caps, anomaly alerts, IP allowlisting, and reliable webhooks) on top of Drupal core access.') . '</p>';

      $output .= '<h2>' . t('Trust model') . '</h2>';
      $output .= '<p>' . t('Governance is decided server-side and never from an agent-supplied header. A request is governed when it arrives over the OAuth agent channel (a <code>simple_oauth</code> bearer token carrying the agent scope), with an optional authenticated-role floor as a fallback. The resolved <em>policy profile</em> then decides the read/write/delete gates, the allowed and denied entity types, redacted fields, rate and quota limits, and the IP allowlist. The <code>X-MCP-Client</code> header is recorded for audit only and is never an enforcement gate; quota, flood, and IP keys derive solely from the server-resolved user and profile, so header manipulation cannot bypass a gate. Cookie-session administrators are ungoverned and unaffected.') . '</p>';

      $output .= '<h2>' . t('Capabilities') . '</h2>';
      $output .= '<ul>';
      $output .= '<li>' . t('<strong>Access governance</strong> — per-profile read/write/delete gates, entity-type allow/deny lists, and field redaction across the MCP Tool, JSON:API, and GraphQL read and write planes.') . '</li>';
      $output .= '<li>' . t('<strong>Tamper-evident audit log</strong> — every governed change is recorded in a hash-chained log, optionally HMAC-keyed, with at-rest metadata encryption (via <code>drupal/encrypt</code>) and SIEM streaming.') . '</li>';
      $output .= '<li>' . t('<strong>DLP redaction</strong> — opt-in value-pattern masking (email, phone, SSN, credit card, and custom patterns) applied to audit diffs and read responses.') . '</li>';
      $output .= '<li>' . t('<strong>Rate limiting and quotas</strong> — per-profile request-rate limits and exfiltration caps that bound how much an agent can read or change in one call.') . '</li>';
      $output .= '<li>' . t('<strong>Anomaly detection</strong> — cron-evaluated rules over the audit stream that raise log, email, or webhook alerts.') . '</li>';
      $output .= '<li>' . t('<strong>IP allowlisting</strong> — per-profile CIDR allowlists. This requires a correctly configured reverse-proxy / trusted-proxy setup; see the project README.') . '</li>';
      $output .= '<li>' . t('<strong>Reliable HMAC webhooks</strong> — signed, retrying webhook deliveries with an SSRF guard, a delivery log, and replay.') . '</li>';
      $output .= '<li>' . t('<strong>Content locks</strong> — short-lived locks that prevent concurrent agent edits to the same entity.') . '</li>';
      $output .= '</ul>';

      $output .= '<h2>' . t('Submodules') . '</h2>';
      $output .= '<ul>';
      $output .= '<li>' . t('<strong>MCP Sentinel Approval</strong> — queues governed destructive operations (bulk delete) for human approval before they execute.') . '</li>';
      $output .= '<li>' . t('<strong>MCP Sentinel GraphQL</strong> — extends mutation gating, field redaction, result caps, and audit to a GraphQL Compose endpoint.') . '</li>';
      $output .= '<li>' . t('<strong>MCP Sentinel Server</strong> — registers the Sentinel Tool plugins with <code>mcp_server</code> and wires OAuth scopes.') . '</li>';
      $output .= '</ul>';

      $output .= '<h2>' . t('Where to configure') . '</h2>';
      $output .= '<ul>';
      $output .= '<li>' . t('<a href=":settings">MCP Sentinel settings</a> — settings are organized into vertical tabs: MCP Access, OAuth agent channel, Audit Logging, Data Loss Prevention, Anomaly detection, Reliable webhooks, and Dashboard broadcast. The Dashboard broadcast tab lets operators post a message (with info/warning/critical severity) that appears as a banner on the governance dashboard. The DLP patterns, anomaly rules, and webhook endpoints lists are now edited as dynamic add/remove rows instead of fixed slots or pipe-delimited textareas.', [':settings' => $settings_url]) . '</li>';
      $output .= '<li>' . t('Policy profiles are managed as configuration entities; create and edit them from the settings page. The profile edit form is organized into vertical tabs — Identity, Allowed operations, Entity scope, Redaction, Rate limits &amp; quotas, and Network / IP — and shows a live plain-language policy summary that updates when key fields change.') . '</li>';
      $output .= '<li>' . t('<a href=":audit">MCP Sentinel audit log</a> — browse, filter, and export governed-operation records.', [':audit' => $audit_url]) . '</li>';
      $output .= '</ul>';

      $output .= '<p>' . t('For full setup, the trust model in depth, and Drush commands, see the project <code>README.md</code>, <code>INSTALL.md</code>, and <code>API.md</code> shipped with the module.') . '</p>';
      return $output;
  }

  return '';
}

/**
 * Implements hook_entity_presave().
 */
function mcp_sentinel_entity_presave(EntityInterface $entity): void {
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  if (!$resolver->isGoverned()) {
    return;
  }

  /** @var \Drupal\mcp_sentinel\Service\McpAuditLogger $logger */
  $logger = \Drupal::service('mcp_sentinel.audit_logger');

  $metadata = [
    'entity_type' => $entity->getEntityTypeId(),
    'bundle'      => $entity->bundle(),
    'id'          => $entity->id() ?: '(new)',
    'label'       => $entity->label(),
    'operation'   => $entity->isNew() ? 'create' : 'update',
  ];

  // For updates on fieldable entities, compute a redaction-aware change diff
  // and attach it to the metadata under a 'changes' key so the audit row
  // captures exactly what was modified.
  if (!$entity->isNew()
    && $entity instanceof FieldableEntityInterface
    && $entity->getOriginal() !== NULL
  ) {
    $profile = $resolver->resolve();
    $redacted = $profile !== NULL ? $profile->getRedactedFields() : [];
    $diff = $logger->computeChangeDiff($entity, $redacted);
    if ($diff !== []) {
      $metadata['changes'] = $diff;
    }
  }

  $logger->log('entity_save', $metadata);
  \Drupal::service('mcp_sentinel.event_dispatcher')->dispatch('mcp.entity.presave', $entity);
}

/**
 * Implements hook_entity_delete().
 */
function mcp_sentinel_entity_delete(EntityInterface $entity): void {
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  if ($resolver->isGoverned()) {
    /** @var \Drupal\mcp_sentinel\Service\McpAuditLogger $logger */
    $logger = \Drupal::service('mcp_sentinel.audit_logger');
    $logger->log('entity_delete', [
      'entity_type' => $entity->getEntityTypeId(),
      'bundle'      => $entity->bundle(),
      'id'          => $entity->id(),
      'label'       => $entity->label(),
    ]);
    \Drupal::service('mcp_sentinel.event_dispatcher')->dispatch('mcp.entity.delete', $entity);
  }
}

/**
 * Implements hook_entity_access().
 */
function mcp_sentinel_entity_access(
  EntityInterface $entity,
  string $operation,
  AccountInterface $account,
): AccessResult {
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  $profile = $resolver->resolve($account);
  if ($profile === NULL) {
    return AccessResult::neutral()->addCacheContexts(['user.roles', 'oauth2_scopes'])->addCacheTags(['config:mcp_sentinel.mcp_policy_profile_list']);
  }
  /** @var \Drupal\mcp_sentinel\Service\McpAccessChecker $checker */
  $checker = \Drupal::service('mcp_sentinel.access_checker');
  return $checker->checkEntityAccess($entity, $operation, $profile)->addCacheContexts(['user.roles', 'oauth2_scopes']);
}

/**
 * Implements hook_entity_create_access().
 *
 * The hook_entity_access() hook does NOT fire for entity CREATE — Drupal routes
 * create access through EntityAccessControlHandler::createAccess() →
 * hook_entity_create_access. JSON:API POST (new entity) goes through that seam,
 * so without this hook a governed agent could POST a new entity and bypass the
 * write gate, the allowed/denied entity-type policy and the IP allowlist. The
 * existing-entity path (PATCH/DELETE) is covered by mcp_sentinel_entity_access;
 * this hook closes the create plane with the SAME governance semantics.
 *
 * The target entity type is read from $context['entity_type_id'] (populated by
 * core's createAccess(), which always sets it). $entity_bundle carries the
 * bundle when known but is not needed here — Sentinel's create governance keys
 * on the entity type, the write gate and the IP allowlist, matching the
 * existing-entity checks.
 */
function mcp_sentinel_entity_create_access(
  AccountInterface $account,
  array $context,
  ?string $entity_bundle,
): AccessResult {
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  $profile = $resolver->resolve($account);
  if ($profile === NULL) {
    return AccessResult::neutral()
      ->addCacheContexts(['user.roles', 'oauth2_scopes'])
      ->addCacheTags(['config:mcp_sentinel.mcp_policy_profile_list']);
  }
  /** @var \Drupal\mcp_sentinel\Service\McpAccessChecker $checker */
  $checker = \Drupal::service('mcp_sentinel.access_checker');
  return $checker
    ->checkCreateAccess((string) $context['entity_type_id'], $profile)
    ->addCacheContexts(['user.roles', 'oauth2_scopes']);
}

/**
 * Implements hook_entity_field_access().
 *
 * Redacts fields listed in the resolved policy profile from MCP responses by
 * forbidding 'view' access for governed agent accounts. This strips the field
 * from JSON:API and REST output and nulls it in GraphQL — a single, uniform
 * redaction across every read channel. The 'user.roles' and 'oauth2_scopes'
 * cache contexts keep governed and non-governed responses cached separately so
 * a value is never served across the boundary.
 */
function mcp_sentinel_entity_field_access(
  string $operation,
  FieldDefinitionInterface $field_definition,
  AccountInterface $account,
  ?FieldItemListInterface $items = NULL,
): AccessResult {
  if ($operation !== 'view') {
    return AccessResult::neutral();
  }
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  $profile = $resolver->resolve($account);

  // Visibility depends on the account's roles and the OAuth agent channel
  // (governed + which profile), so the result must vary by both 'user.roles'
  // and 'oauth2_scopes' for the redacted and neutral outcomes — a redacted
  // agent response is never served to a cookie-session request, and vice versa.
  $redacted = $profile !== NULL
    && in_array($field_definition->getName(), $profile->getRedactedFields(), TRUE);
  $result = $redacted
    ? AccessResult::forbidden('Field redacted by MCP Sentinel.')
    : AccessResult::neutral();
  return $result
    ->addCacheContexts(['user.roles', 'oauth2_scopes'])
    ->addCacheTags(['config:mcp_sentinel.settings', 'config:mcp_sentinel.mcp_policy_profile_list']);
}

/**
 * Implements hook_jsonapi_entity_filter_access().
 */
function mcp_sentinel_jsonapi_entity_filter_access(
  EntityTypeInterface $entity_type,
  AccountInterface $account,
): array {
  $resolver = \Drupal::service('mcp_sentinel.policy_resolver');
  $profile = $resolver->resolve($account);
  if ($profile === NULL) {
    return [];
  }
  /** @var \Drupal\mcp_sentinel\Service\McpAccessChecker $checker */
  $checker = \Drupal::service('mcp_sentinel.access_checker');
  return $checker->getJsonApiFilterAccess($entity_type->id(), $profile);
}

/**
 * Implements hook_mail().
 *
 * Formats outbound emails for anomaly alerts. The 'anomaly_alert' key is used
 * by McpAlertDispatcher when anomaly_alert_email is non-empty.
 */
function mcp_sentinel_mail(string $key, array &$message, array $params): void {
  if ($key === 'anomaly_alert') {
    $message['subject'] = $params['subject'] ?? 'MCP Sentinel anomaly alert';
    $message['body'][] = $params['body'] ?? '';
  }
}

/**
 * Implements hook_cron().
 */
function mcp_sentinel_cron(): void {
  $pruned = \Drupal::service('mcp_sentinel.audit_logger')->pruneOldEntries();
  if ($pruned > 0) {
    \Drupal::logger('mcp_sentinel')->info(
      'Pruned @count old MCP audit log entries.',
      ['@count' => $pruned]
    );
  }
  \Drupal::service('mcp_sentinel.content_lock')->releaseExpired();

  $prunedWebhooks = \Drupal::service('mcp_sentinel.webhook_queue_manager')->pruneOldDeliveries();
  if ($prunedWebhooks > 0) {
    \Drupal::logger('mcp_sentinel')->info(
      'Pruned @count old webhook delivery log rows.',
      ['@count' => $prunedWebhooks]
    );
  }

  // Re-enqueue pending webhook delivery rows whose backoff has elapsed, and
  // recover rows that were inserted but never successfully enqueued (e.g. if
  // the queue backend was unavailable at dispatch time). This replaces the
  // RequeueException busy-loop: the worker returns without re-queuing for
  // not-yet-due items; this cron scan enqueues them when they are due.
  $requeued = \Drupal::service('mcp_sentinel.webhook_queue_manager')->requeueDuePendingRows();
  if ($requeued > 0) {
    \Drupal::logger('mcp_sentinel')->info(
      'Re-enqueued @count due webhook delivery rows.',
      ['@count' => $requeued]
    );
  }

  // Evaluate anomaly-detection rules against the audit stream. A rule that
  // fires triggers log/email/webhook alerts via McpAlertDispatcher.
  // Wrapped in try/catch so a detector exception never breaks cron entirely.
  try {
    /** @var \Drupal\mcp_sentinel\Service\McpAnomalyDetector $detector */
    $detector = \Drupal::service('mcp_sentinel.anomaly_detector');
    $firedRules = $detector->evaluate();
    if ($firedRules) {
      /** @var \Drupal\mcp_sentinel\Service\McpAlertDispatcher $alertDispatcher */
      $alertDispatcher = \Drupal::service('mcp_sentinel.anomaly_alert_dispatcher');
      $alertDispatcher->dispatch($firedRules);
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('mcp_sentinel')->error(
      'Anomaly detection failed during cron: @message',
      ['@message' => $e->getMessage()]
    );
  }
}
