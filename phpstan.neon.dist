# PHPStan configuration for MCP Sentinel.
# Run on Drupal CI via commit-code-check.sh; phpstan-drupal is provided there.
includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
  level: 6
  # Inline @phpstan-ignore comments may not match across phpstan versions.
  reportUnmatchedIgnoredErrors: false
  paths:
    - .
  excludePaths:
    - vendor (?)
  fileExtensions:
    - php
    - module
    - inc
    - install
  ignoreErrors:
    # new static() is a Drupal best practice for plugins.
    - "#^Unsafe usage of new static#"
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    # The test suite uses PHPUnit attributes (#[Group], #[CoversClass], ...).
    # This module supports Drupal 10.6, which ships PHPUnit 9 — a version with no
    # PHPUnit\Framework\Attributes namespace at all — so when the previous-major
    # job analyses against that stack every attribute resolves to a missing class.
    # That is a static-analysis artifact, not a defect: PHP attributes are inert
    # unless something reflects on them, so PHPUnit 9 ignores them and the suite
    # passes there. Reassess when the supported floor rises above Drupal 10.
    - "#Attribute class PHPUnit.*Attributes.* does not exist#"
    # The GraphQL governance test builds operation fixtures via methods the
    # webonyx/graphql-php library marks @internal — unavoidable in tests.
    -
      identifier: method.internal
      path: modules/mcp_sentinel_graphql/tests/src/Kernel/GraphqlGovernanceSubscriberTest.php
    # Update-hook tests call assertIsString() on hook return values that
    # phpstan narrows to string from the function signature; the assertion
    # is intentional (it documents the contract) and harmless.
    -
      identifier: method.alreadyNarrowedType
      path: tests/src/Kernel/McpUpdateHookChainTest.php
    # Server registration test calls assertNotNull() on plugin instances that
    # phpstan considers non-null from the createInstance() @return type.
    -
      identifier: method.alreadyNarrowedType
      path: modules/mcp_sentinel_server/tests/src/Kernel/McpServerRegistrationTest.php
    # bleedingEdge phpunit.coversMethod false-positives on a second test method
    # that @covers an already-covered, genuinely-existing public method
    # (McpMetrics::deniedReasons). The annotation is correct; the rule is pedantic.
    -
      identifier: phpunit.coversMethod
      path: tests/src/Kernel/McpMetricsTest.php
