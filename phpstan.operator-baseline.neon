      count: 2
      path: mcp_sentinel.install
    -
      message: '#^Function mcp_sentinel_requirements\(\) return type has no value type specified in iterable type array\.$#'
      identifier: missingType.iterableValue
      count: 1
      path: mcp_sentinel.install
    -
