# Baseline for untouched 1.x code in McpKillSwitch.php and
# mcp_sentinel.install. Generated under PHPStan max +
# phpstan-strict-rules with messages so identifier buckets
# cannot absorb new DEV-986 errors. The two 10037
# fetchAll(PDO::FETCH_ASSOC) hits are covered by the
# path-scoped ignore in phpstan.operator.neon, not here.
# New DEV-986 code must not add entries.
parameters:
  ignoreErrors:
    -
      message: '#^Parameter \#1 \$array of function array_diff expects an array of values castable to string, array\<mixed, mixed\> given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#1 \$array of function array_unique expects an array of values castable to string, array\<mixed\> given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#1 \$key of static method Drupal\\mcp_sentinel\\Service\\McpFloodKey\:\:normalize\(\) expects string, mixed given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$array of function array_key_exists expects array, mixed given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$table of method Drupal\\Core\\Database\\Schema\:\:createTable\(\) expects array, mixed given\.$#'
      identifier: argument.type
      count: 4
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$value of method Drupal\\Core\\Database\\Query\\ConditionInterface\:\:condition\(\) expects array\|Drupal\\Core\\Database\\Query\\SelectInterface\|int\|string\|null, mixed given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$value of method Drupal\\Core\\Database\\Query\\Update\:\:condition\(\) expects array\|Drupal\\Core\\Database\\Query\\SelectInterface\|int\|string\|null, mixed given\.$#'
      identifier: argument.type
      count: 2
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#3 \$spec of method Drupal\\Core\\Database\\Schema\:\:addField\(\) expects array, mixed given\.$#'
      identifier: argument.type
      count: 5
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#4 \$spec of method Drupal\\Core\\Database\\Schema\:\:addIndex\(\) expects array, mixed given\.$#'
      identifier: argument.type
      count: 3
      path: mcp_sentinel.install
    -
      message: '#^Only iterables can be unpacked, mixed given\.$#'
      identifier: arrayUnpacking.nonIterable
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Binary operation "/" between mixed and mixed results in an error\.$#'
      identifier: binaryOp.invalid
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Only booleans are allowed in a negated boolean, Drupal\\key\\Entity\\Key\|null given\.$#'
      identifier: booleanNot.exprNotBoolean
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Only booleans are allowed in a negated boolean, Drupal\\mcp_sentinel\\Entity\\McpPolicyProfile\|null given\.$#'
      identifier: booleanNot.exprNotBoolean
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Only booleans are allowed in a negated boolean, Drupal\\user\\Entity\\Role\|null given\.$#'
      identifier: booleanNot.exprNotBoolean
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Only booleans are allowed in a negated boolean, mixed given\.$#'
      identifier: booleanNot.exprNotBoolean
      count: 2
      path: mcp_sentinel.install
    -
      message: '#^Only booleans are allowed in \|\|, mixed given on the right side\.$#'
      identifier: booleanOr.rightNotBoolean
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Cannot cast mixed to int\.$#'
      identifier: cast.int
      count: 9
      path: mcp_sentinel.install
    -
      message: '#^Cannot cast mixed to string\.$#'
      identifier: cast.string
      count: 6
      path: mcp_sentinel.install
    -
      message: '#^Construct empty\(\) is not allowed\. Use more strict comparison\.$#'
      identifier: empty.notAllowed
      count: 3
      path: mcp_sentinel.install
    -
      message: '#^Part \$sandbox\[''migrated''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
      identifier: encapsedStringPart.nonString
      count: 2
      path: mcp_sentinel.install
    -
      message: '#^Part \$sandbox\[''total''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
      identifier: encapsedStringPart.nonString
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Argument of an invalid type Drupal\\Core\\Database\\StatementInterface\|null supplied for foreach, only iterables are supported\.$#'
      identifier: foreach.nonIterable
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Only booleans are allowed in an if condition, Drupal\\user\\Entity\\Role\|null given\.$#'
