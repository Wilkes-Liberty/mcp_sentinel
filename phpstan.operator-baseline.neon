# Baseline for untouched 1.x code in McpKillSwitch.php and
# mcp_sentinel.install, plus errors already present in
# mcp_sentinel.module, McpWebhookQueueManager, and
# McpWebhookWorker when those files joined the operator scan.
# Generated under PHPStan max + phpstan-strict-rules with
# messages so identifier buckets cannot absorb new DEV-986
# errors. Install/KillSwitch entries are from Tests
# 39110065729 (bff12db). Module/queue/worker messages are
# file-local errors that predate this PR's product changes;
# they are not a claim that Tests 39115568856 was a 1.x run
# or that 39110065729 scanned the module. QueueManager
# hold-path reads are typed, so the cast.string / cast.int
# buckets are not a #318 absorb. The two 10037
# fetchAll(PDO::FETCH_ASSOC) hits are covered by the
# path-scoped ignore in phpstan.operator.neon, not here.
# New DEV-985 / DEV-986 code must not add entries.
parameters:
  ignoreErrors:
    -
      message: '#^Parameter \#1 \$array of function array_diff expects an array of values castable to string, array\<mixed, mixed\> given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#1 \$array of function array_unique expects an array of values castable to string, array\<mixed\> given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#1 \$key of static method Drupal\\mcp_sentinel\\Service\\McpFloodKey\:\:normalize\(\) expects string, mixed given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$array of function array_key_exists expects array, mixed given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$table of method Drupal\\Core\\Database\\Schema\:\:createTable\(\) expects array, mixed given\.$#'
      identifier: argument.type
      count: 4
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$value of method Drupal\\Core\\Database\\Query\\ConditionInterface\:\:condition\(\) expects array\|Drupal\\Core\\Database\\Query\\SelectInterface\|int\|string\|null, mixed given\.$#'
      identifier: argument.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Parameter \#2 \$value of method Drupal\\Core\\Database\\Query\\Update\:\:condition\(\) expects array\|Drupal\\Core\\Database\\Query\\SelectInterface\|int\|string\|null, mixed given\.$#'
