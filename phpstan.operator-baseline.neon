      identifier: offsetAccess.nonOffsetAccessible
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Cannot use \+\+ on mixed\.$#'
      identifier: postInc.type
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Cannot access property \$event on mixed\.$#'
      identifier: property.nonObject
      count: 3
