      identifier: missingType.iterableValue
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Function mcp_sentinel_update_10023\(\) has parameter \$sandbox with no value type specified in iterable type array\.$#'
      identifier: missingType.iterableValue
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Cannot access offset ''escalated_at'' on mixed\.$#'
      identifier: offsetAccess.nonOffsetAccessible
      count: 1
      path: mcp_sentinel.install
    -
      message: '#^Cannot access offset ''fields'' on mixed\.$#'
      identifier: offsetAccess.nonOffsetAccessible
      count: 4
      path: mcp_sentinel.install
    -
      message: '#^Cannot access offset ''human_key''\|''principal_key''\|''tenant'' on mixed\.$#'
      identifier: offsetAccess.nonOffsetAccessible
