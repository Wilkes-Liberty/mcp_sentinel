<?php

/**
 * @file
 * Install, update, and uninstall functions for MCP Sentinel.
 */

use Drupal\Core\Utility\UpdateException;
use Drupal\Core\Url;
use Drupal\key\Entity\Key;
use Drupal\mcp_sentinel\Entity\McpPolicyProfile;
use Drupal\user\Entity\Role;

/**
 * Implements hook_schema().
 *
 * Defines the two tables that hold runtime governance state rather than
 * configuration. On uninstall, core drops both automatically from this
 * definition (see mcp_sentinel_uninstall()).
 */
function mcp_sentinel_schema(): array {
  // The audit trail itself is no longer defined here: it moved to the
  // audit_chain module, which owns the audit_chain_log table and the hash
  // chain over it. mcp_sentinel writes to it under the 'mcp_sentinel' channel.
  // Update 10016 migrates the rows; see McpAuditLogger.
  //
  // Durable record of each webhook delivery attempt, decoupled from the queue
  // so deliveries survive a queue flush and can be replayed. 'status' tracks
  // the lifecycle (pending/delivered/failed); 'attempts' and 'next_attempt'
  // drive the exponential backoff and the cron requeue scan; 'item_id' links
  // the row to its in-flight queue item; the last_response_* columns retain the
  // most recent endpoint reply for the delivery log UI.
  $schema['mcp_sentinel_webhook_delivery'] = [
    'description' => 'Webhook delivery log for queued, retried MCP notifications.',
    'fields' => [
      'id'                 => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'endpoint_id'        => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'event_name'         => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'payload_hash'       => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'payload'            => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'status'             => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'pending'],
      'attempts'           => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_attempt'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'next_attempt'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'last_response_code' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'last_response_body' => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'created'            => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'item_id'            => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    // 'status' + 'next_attempt' support the cron scan for due pending rows;
    // 'created' backs retention pruning; 'endpoint_id' backs per-endpoint
    // filtering in the delivery log UI.
    'indexes' => [
      'status'       => ['status'],
      'next_attempt' => ['next_attempt'],
      'created'      => ['created'],
      'endpoint_id'  => ['endpoint_id'],
    ],
  ];

  // Short-lived advisory locks preventing concurrent agent writes to the same
  // entity. Keyed on (entity_type, entity_id) so at most one lock exists per
  // target; 'expires_at' bounds the lock lifetime and is pruned on cron.
  $schema['mcp_sentinel_content_locks'] = [
    'description' => 'Content items locked against MCP writes.',
    'fields' => [
      'entity_type' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'entity_id'   => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'locked_by'   => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'locked_at'   => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'expires_at'  => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'reason'      => ['type' => 'varchar', 'length' => 512, 'not null' => FALSE],
    ],
    'primary key' => ['entity_type', 'entity_id'],
    // Backs the cron sweep that releases expired locks.
    'indexes' => ['expires_at' => ['expires_at']],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Seeds the 'mcp_api' role with the minimum read permissions an agent account
 * needs, so a fresh install has a ready-to-assign governed identity. The role
 * is only created when absent, keeping reinstall idempotent.
 */
function mcp_sentinel_install(): void {
  if (!\Drupal::entityTypeManager()->getStorage('user_role')->load('mcp_api')) {
    Role::create(['id' => 'mcp_api', 'label' => 'MCP API', 'weight' => 10])->save();
    user_role_grant_permissions('mcp_api', [
      'access content',
      'access user profiles',
      'view media',
      'access mcp sentinel context',
    ]);
    \Drupal::messenger()->addStatus(t('MCP API role created. Assign it to your API user in /admin/people.'));
  }
  \Drupal::messenger()->addStatus(
    t('MCP Sentinel installed. Configure at <a href=":url">Configuration → MCP Sentinel</a>.', [
      ':url' => Url::fromRoute('mcp_sentinel.settings')->toString(),
    ])
  );
}

/**
 * Implements hook_requirements().
 *
 * Fail-loud guard against the silent no-op failure mode: when the module is
 * enabled but governance can never engage, it fails open without telling
 * anyone.
 * This emits a runtime status-report WARNING in either of the two situations
 * where no request can ever be governed and gated:
 *
 *   - No channel can trigger governance. McpOauthContext::isAgentChannel() can
 *     only return TRUE when agent_oauth_clients or agent_scopes is non-empty,
 *     and the local-dev role fallback (McpPolicyResolver::isGoverned()) only
 *     applies when governed_role_fallback is on AND a non-forbidden governed
 *     role is configured. If neither path can ever fire, isGoverned() is always
 *     FALSE and no entity-access gate runs.
 *   - No policy profile exists. Even when a request is governed,
 *     McpPolicyResolver::resolve() returns NULL when there is no policy profile
 *     to resolve to, so no read/write/delete gate is ever applied.
 *
 * The check mirrors how isAgentChannel()/McpPolicyResolver actually decide so
 * the warning is accurate, and links to the settings form so the operator can
 * fix it. It only runs in the 'runtime' phase (status report); install does not
 * need it because a fresh install ships sensible defaults.
 */
function mcp_sentinel_requirements(string $phase): array {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  // Checked first, and deliberately before the governance early-return below:
  // without audit_chain this module cannot record anything at all, which is
  // true whether or not governance is switched on. McpAuditLogger throws rather
  // than recording nothing quietly, so in this state governed writes are
  // refused — the status report has to say why.
  if (!\Drupal::moduleHandler()->moduleExists('audit_chain')) {
    $requirements['mcp_sentinel_audit_chain_missing'] = [
      'title' => t('MCP Sentinel: audit_chain is not enabled'),
      'value' => t('Required module missing'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('MCP Sentinel records every governed operation through the <code>audit_chain</code> module, which is not enabled. Governed operations are refused rather than performed unaudited. Run <code>drush en audit_chain</code> and then <code>drush updatedb</code>.'),
    ];
    return $requirements;
  }

  // Uncertain evidence receipts (#3616539): a governed evidence-required
  // mutation is durable but its execution receipt has not committed. Cron
  // retries reconciliation; until the ledger drains, the gap is an ERROR —
  // a high-assurance action without its proof is exactly what the
  // evidence-required class exists to prevent, and it must never sit green.
  // Before the enabled early-return on purpose: disabling governance after
  // the fact must not hide a ledger that has not drained.
  $uncertain = \Drupal::service('mcp_sentinel.evidence_guard')->uncertainCount();
  if ($uncertain > 0) {
    $requirements['mcp_sentinel_evidence_uncertain'] = [
      'title' => t('MCP Sentinel: evidence receipts awaiting reconciliation'),
      'value' => t('@count uncertain receipt(s) pending', ['@count' => $uncertain]),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('One or more governed evidence-required mutations are durable but their execution receipts could not commit to the audit chain. Reconciliation retries on cron; if this persists, check the audit chain storage and signing key. These outcomes are recorded as uncertain and are not reported as proven successes.'),
    ];
  }

  $config = \Drupal::config('mcp_sentinel.settings');
  if (!$config->get('enabled')) {
    // The operator has explicitly turned governance off; nothing to warn about.
    return $requirements;
  }

  // Report the same connector-facing source contract enforced at runtime.
  // This is intentionally stricter than the legacy "a channel could fire"
  // warning below: a non-empty scope string is not production readiness when
  // server/OAuth/audit/tool registration or designated identity wiring is
  // absent. Reuse the typed evaluator so the status report, readiness endpoint,
  // Tool base, and API subscribers cannot drift into conflicting answers.
  if (\Drupal::hasService('mcp_sentinel.governance_readiness')) {
    /** @var \Drupal\mcp_sentinel\Service\McpGovernanceReadiness $readiness */
    $readiness = \Drupal::service('mcp_sentinel.governance_readiness');
    $contract = $readiness->contractStatus();
    if (!$contract->isReady()) {
      $reason = $contract->reason()->value;
      $requirements['mcp_sentinel_contract_not_ready'] = [
        'title' => t('MCP Sentinel: source-governance contract not ready'),
        'value' => t('Not ready (@reason)', ['@reason' => $reason]),
        'severity' => REQUIREMENT_ERROR,
        'description' => t('Governed MCP product paths are refused until the source contract is complete. Review the <a href=":url">MCP Sentinel settings</a>, enable the required server/bridge/OAuth/audit modules, provision a designated active Consumer whose owner resolves to an applicable role-bound profile, and register every Tool with required authentication and its exact derived scope. The readiness signal does not claim policy effectiveness, verified evidence, or overall security posture.', [
          ':url' => Url::fromRoute('mcp_sentinel.settings')->toString(),
        ]),
      ];
    }
  }

  // The finite-read-budget override is a deliberate, visible weakening
  // (#3616540): with require_finite_read_budgets FALSE, an unlimited (0)
  // profile budget really is unlimited and nothing bounds a mass read. That
  // is acceptable only as a non-production posture, so it can never sit
  // silently green — a secure-install verification must always see this row.
  if ($config->get('require_finite_read_budgets') === FALSE) {
    $requirements['mcp_sentinel_read_budgets'] = [
      'title' => t('MCP Sentinel: unlimited read budgets permitted'),
      'value' => t('Non-production override active'),
      'severity' => REQUIREMENT_WARNING,
      'description' => t('require_finite_read_budgets is disabled, so profiles with unlimited (0) rate, result, size, or page budgets impose no mass-read/exfiltration floor. This override is for non-production use only; remove it (or set finite budgets on every governed profile) before treating this install as production-secure.'),
    ];
  }

  // Classification without ceilings (d.o #3616540 part 2): the site has
  // labelled data above the floor, but a production-oriented profile — one
  // bound to agent roles; the role-less default is a fallback, not a
  // production policy — sets no egress ceiling, so nothing enforces those
  // labels for it. Not silent nothing: an advisory warning until ceilings
  // are set (or the labels removed). The mechanism itself ships dark, so
  // this row is the only place the gap is visible.
  if (\Drupal::hasService('mcp_sentinel.classification')
    && \Drupal::service('mcp_sentinel.classification')->assignsAboveLowest()) {
    $unceilinged = [];
    /** @var \Drupal\mcp_sentinel\McpPolicyProfileInterface[] $profiles */
    $profiles = \Drupal::entityTypeManager()->getStorage('mcp_policy_profile')->loadMultiple();
    foreach ($profiles as $profile) {
      if ($profile->status() && $profile->getRoles() !== [] && $profile->getEgressCeilings() === []) {
        $unceilinged[] = $profile->id();
      }
    }
    if ($unceilinged !== []) {
      $requirements['mcp_sentinel_classification_ceilings'] = [
        'title' => t('MCP Sentinel: classified data without egress ceilings'),
        'value' => t('Profile(s) without ceilings: @profiles', ['@profiles' => implode(', ', $unceilinged)]),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('The classification map labels data above the lowest label, but the listed role-bound policy profile(s) set no egress ceilings, so those labels are not enforced for the principals they govern. Set per-surface ceilings (egress_ceilings) on each profile, or remove the labels if classification is not intended here.'),
      ];
    }
  }

  // Permanently failed webhook deliveries are otherwise invisible
  // (#3613242): rows land in failed / failed_ssrf / failed_redirect and sit
  // silently until retention prunes them — a month of 100% delivery failure
  // was once only discovered by querying the table by hand. Surface any
  // accumulation on the status report, before the governance early-return
  // below so it shows regardless of governance health.
  // The table guard scopes ONLY this webhook check — the governance checks
  // below must still run without it. The module can be enabled while its
  // schema is not yet (or no longer) installed: mid-install, mid-uninstall,
  // and kernel tests that enable the module without installing the schema all
  // reach runtime requirements in that state, and a status check must never
  // itself crash (nor swallow the other warnings).
  if (\Drupal::database()->schema()->tableExists('mcp_sentinel_webhook_delivery')) {
    $failedQuery = \Drupal::database()->select('mcp_sentinel_webhook_delivery', 'd')
      ->condition('d.status', ['failed', 'failed_ssrf', 'failed_redirect', 'failed_key'], 'IN');
    $failedQuery->addExpression('COUNT(*)', 'n');
    $failedQuery->addExpression('MAX(last_attempt)', 'latest');
    $failedRow = $failedQuery->execute()->fetchAssoc();
    if ((int) ($failedRow['n'] ?? 0) > 0) {
      $requirements['mcp_sentinel_webhook_failures'] = [
        'title' => t('MCP Sentinel: webhook deliveries permanently failing'),
        'value' => t('@count delivery(ies) permanently failed; most recent attempt @when', [
          '@count' => (int) $failedRow['n'],
          '@when' => \Drupal::service('date.formatter')->format((int) $failedRow['latest'], 'custom', 'Y-m-d H:i'),
        ]),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('Webhook events are silently not reaching their destination. Inspect the <a href=":url">delivery log</a> — the per-row status and last response say why (unreachable endpoint, redirect, SSRF block, non-2xx receiver). Rows prune after the configured retention period, but the cause does not fix itself.', [
          ':url' => Url::fromRoute('mcp_sentinel.webhook_delivery')->toString(),
        ]),
      ];
    }
  }

  // Pre-flight every enabled endpoint's signing key (#3613291): a declared
  // secret_key whose Key entity is missing or resolves empty means the worker
  // will refuse every delivery for that endpoint (fail closed) — surface the
  // misconfiguration before a single delivery is attempted.
  $badKeys = [];
  foreach ((array) $config->get('webhook_endpoints') as $endpoint) {
    if (empty($endpoint['enabled'])) {
      continue;
    }
    $keyId = (string) ($endpoint['secret_key'] ?? '');
    if ($keyId === '') {
      continue;
    }
    $key = \Drupal::service('key.repository')->getKey($keyId);
    if ($key === NULL || (string) $key->getKeyValue() === '') {
      $badKeys[] = (string) ($endpoint['id'] ?? '?') . ' → ' . $keyId;
    }
  }
  if ($badKeys !== []) {
    $requirements['mcp_sentinel_webhook_signing_keys'] = [
      'title' => t('MCP Sentinel: webhook signing key unresolvable'),
      'value' => t('@list', ['@list' => implode(', ', $badKeys)]),
      'severity' => REQUIREMENT_WARNING,
      'description' => t('These enabled endpoints declare a signing key that is missing or resolves to an empty value. Every delivery for them is refused (failed_key) rather than sent unsigned. Fix the Key entity or remove secret_key from the endpoint.'),
    ];
  }

  // Escape-hatch permissions on governed roles (#65). Reported at ERROR, not
  // WARNING, and deliberately before the governance early-return below: unlike
  // a misconfiguration, this is a control that *looks* configured while not
  // being a boundary at all — the profile still advertises its deny lists and
  // redactions while the role can step around them without making an MCP
  // request. A live case had the agent role holding 'bypass file gate'
  // alongside 18 profile permissions, and nothing surfaced it.
  $roleViolations = \Drupal::service('mcp_sentinel.role_assertions')->violations();
  if ($roleViolations !== []) {
    $assertions = \Drupal::service('mcp_sentinel.role_assertions');
    $items = array_map(
      static fn(array $violation): string => $assertions->describe($violation),
      $roleViolations,
    );
    $requirements['mcp_sentinel_role_escape_hatch'] = [
      'title' => t('MCP Sentinel: governed role holds an escape-hatch permission'),
      'value' => t('@count governed-role violation(s)', ['@count' => count($roleViolations)]),
      'severity' => REQUIREMENT_ERROR,
      'description' => [
        '#theme' => 'item_list',
        '#items' => $items,
        '#prefix' => '<p>' . t("A policy profile constrains what an agent may do through the MCP channel. These permissions let the same role act <em>outside</em> that channel, where no policy, redaction or audit applies — so the profile below is not the boundary it appears to be. Revoke the permission, or record the exception in the profile's <code>acknowledged_role_permissions</code>.") . '</p>',
      ],
    ];
  }

  // Mirror McpOauthContext::isAgentChannel(): the agent channel can only ever
  // fire when at least one client_id or one scope is configured.
  $has_agent_clients = !empty($config->get('agent_oauth_clients'));
  $has_agent_scopes = !empty($config->get('agent_scopes'));
  $channel_can_fire = $has_agent_clients || $has_agent_scopes;

  // Mirror McpPolicyResolver::isGoverned(): the local-dev role fallback can
  // only govern when it is enabled AND a usable (non-forbidden) governed
  // role exists.
  $forbidden_roles = ['anonymous', 'authenticated'];
  $governed_roles = array_diff((array) ($config->get('governed_roles') ?? []), $forbidden_roles);
  $role_fallback_can_fire = (bool) $config->get('governed_role_fallback') && !empty($governed_roles);

  $can_be_governed = $channel_can_fire || $role_fallback_can_fire;

  // Mirror McpPolicyResolver::resolve(): without a policy profile, even a
  // governed request resolves to NULL and no gate is applied.
  $has_profile = (bool) \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->getQuery()
    ->accessCheck(FALSE)
    ->range(0, 1)
    ->count()
    ->execute();

  if ($can_be_governed && $has_profile) {
    // Governance can engage; no warning needed.
    return $requirements;
  }

  // Build an actionable description listing exactly which precondition failed.
  $reasons = [];
  if (!$can_be_governed) {
    $reasons[] = t('No request can be recognised as a governed agent request: <code>agent_scopes</code> and <code>agent_oauth_clients</code> are both empty, and the local-dev role fallback is not usable. Configure <code>agent_scopes</code> (e.g. <code>mcp_read</code>, <code>mcp_write</code>) and/or <code>agent_oauth_clients</code>.');
  }
  if (!$has_profile) {
    $reasons[] = t('No policy profile exists, so even a governed request resolves to no policy and no read/write/delete gate is applied. Create at least one policy profile.');
  }

  $requirements['mcp_sentinel_not_governing'] = [
    'title' => t('MCP Sentinel: not governing any request'),
    'value' => t('Enabled but not governing'),
    'severity' => REQUIREMENT_WARNING,
    'description' => [
      '#theme' => 'item_list',
      '#items' => $reasons,
      '#prefix' => '<p>' . t('MCP Sentinel is enabled but cannot govern any request, so it is failing open silently. Fix one or more of the following, then review the <a href=":url">MCP Sentinel settings</a>:', [
        ':url' => Url::fromRoute('mcp_sentinel.settings')->toString(),
      ]) . '</p>',
    ],
  ];

  return $requirements;
}

/**
 * Move the plaintext webhook secret into a Key entity.
 */
function mcp_sentinel_update_10001(): string {
  $config = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
  $legacy = (string) $config->get('webhook_secret');

  if ($legacy === '' || $config->get('webhook_secret_key')) {
    // Nothing to migrate, or already migrated.
    $config->set('webhook_secret_key', $config->get('webhook_secret_key') ?? '')
      ->clear('webhook_secret')->save();
    return 'No plaintext webhook secret to migrate.';
  }

  $key_id = 'mcp_sentinel_webhook';
  if (!Key::load($key_id)) {
    Key::create([
      'id' => $key_id,
      'label' => 'MCP Sentinel webhook secret',
      'key_type' => 'authentication',
      'key_provider' => 'config',
      'key_provider_settings' => ['key_value' => $legacy],
    ])->save();
  }

  $config->set('webhook_secret_key', $key_id)->clear('webhook_secret')->save();

  return "Migrated the webhook secret into Key '$key_id'. For stronger security, "
    . 'switch that key to a File or Environment provider so the value leaves '
    . 'exported configuration.';
}

/**
 * Migrate access/redaction settings into the default policy profile.
 */
function mcp_sentinel_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');

  if (!McpPolicyProfile::load('default')) {
    McpPolicyProfile::create([
      'id' => 'default',
      'label' => 'Default',
      'weight' => 0,
      'roles' => [],
      'allow_read' => (bool) ($config->get('allow_read') ?? TRUE),
      'allow_write' => (bool) ($config->get('allow_write') ?? TRUE),
      'allow_delete' => (bool) ($config->get('allow_delete') ?? FALSE),
      'allow_graphql_mutations' => (bool) ($config->get('allow_graphql_mutations') ?? FALSE),
      'allowed_entity_types' => $config->get('allowed_entity_types') ?? [],
      'denied_entity_types' => $config->get('denied_entity_types') ?? ['user'],
      'redacted_fields' => $config->get('redacted_fields') ?? ['pass', 'mail'],
    ])->save();
  }

  if (!$config->get('governed_roles')) {
    $config->set('governed_roles', ['mcp_api']);
  }
  foreach ([
    'allow_read',
    'allow_write',
    'allow_delete',
    'allow_graphql_mutations',
    'allowed_entity_types',
    'denied_entity_types',
    'redacted_fields',
  ] as $key) {
    $config->clear($key);
  }
  $config->save();

  return 'Migrated MCP access/redaction settings into the default policy profile.';
}

/**
 * Add prev_hash and row_hash columns to mcp_sentinel_audit_log.
 */
function mcp_sentinel_update_10003(): string {
  $schema = \Drupal::database()->schema();
  $table = 'mcp_sentinel_audit_log';

  // A site installed at 1.14 or later never had this table — the chain lives in
  // audit_chain now — so there is nothing to add columns to. Historical update
  // hooks still have to run in order on a site upgrading from before that, and
  // they must no-op rather than fatal on a site that skipped it.
  if (!$schema->tableExists($table)) {
    return 'No legacy audit table on this site; the audit chain lives in audit_chain.';
  }

  if (!$schema->fieldExists($table, 'prev_hash')) {
    $schema->addField($table, 'prev_hash', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
    ]);
  }

  if (!$schema->fieldExists($table, 'row_hash')) {
    $schema->addField($table, 'row_hash', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
    ]);
    $schema->addIndex($table, 'row_hash', ['row_hash'], [
      'fields' => [
        'row_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      ],
    ]);
  }

  return 'Added prev_hash and row_hash columns to mcp_sentinel_audit_log for tamper-evident hash chaining.';
}

/**
 * Add audit_hash_key setting for HMAC-keyed audit hash chain.
 *
 * Historically this wrote mcp_sentinel.settings:audit_hash_key. That key moved
 * to audit_chain.settings:hash_key in 2.0.0 and was removed from this module's
 * schema (see update 10018). Sites that already ran the original 10004 keep
 * whatever they had until 10016/10018 clear it. On a path that still executes
 * 10004 under current code, seed the living home instead of a removed key.
 */
function mcp_sentinel_update_10004(): string {
  if (\Drupal::moduleHandler()->moduleExists('audit_chain')) {
    $chain = \Drupal::configFactory()->getEditable('audit_chain.settings');
    if ($chain->get('hash_key') === NULL) {
      $chain->set('hash_key', '')->save();
    }
    return 'audit_hash_key lives in audit_chain.settings:hash_key (moved in 2.0.0); ensured the default is present.';
  }
  return 'audit_hash_key no longer lives on mcp_sentinel.settings (moved to audit_chain in 2.0.0).';
}

/**
 * Add DLP settings: dlp_enabled, dlp_mask_mode, dlp_patterns.
 */
function mcp_sentinel_update_10005(): string {
  $config = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
  if ($config->get('dlp_enabled') === NULL) {
    $config->set('dlp_enabled', FALSE);
  }
  if ($config->get('dlp_mask_mode') === NULL) {
    $config->set('dlp_mask_mode', 'redact');
  }
  if ($config->get('dlp_patterns') === NULL) {
    $config->set('dlp_patterns', [
      ['label' => 'email', 'regex' => '[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}', 'mask' => '*'],
      ['label' => 'us_phone', 'regex' => '\(?\d{3}\)?[\s.\-]\d{3}[\s.\-]\d{4}', 'mask' => '*'],
      ['label' => 'ssn', 'regex' => '\d{3}-\d{2}-\d{4}', 'mask' => '*'],
      ['label' => 'credit_card', 'regex' => '\b\d{4}[\s\-]\d{4}[\s\-]\d{4}[\s\-]\d{4}\b', 'mask' => '*'],
    ]);
  }
  $config->save();
  return 'Added DLP settings (dlp_enabled=FALSE, dlp_mask_mode=redact, four built-in patterns). Enable DLP at Configuration → Web services → MCP Sentinel.';
}

/**
 * Add rate limit, result cap, and response size cap fields to policy profiles.
 */
function mcp_sentinel_update_10006(): string {
  // Backfill per-key defaults: rate_limit_window defaults to 60 so that setting
  // rate_limit_requests > 0 on an upgraded profile immediately takes effect.
  // The cap fields (result_count_cap, response_size_cap) and the request count
  // field default to 0 which means "unlimited / not enforced".
  $defaults = [
    'rate_limit_requests' => 0,
    'rate_limit_window'   => 60,
    'result_count_cap'    => 0,
    'response_size_cap'   => 0,
  ];
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    foreach ($defaults as $k => $default) {
      if ($e->get($k) === NULL) {
        $e->set($k, $default);
      }
    }
    $e->save();
  }
  return 'Added rate_limit_requests (default 0 = unlimited), '
    . 'rate_limit_window (default 60 s), result_count_cap, '
    . 'response_size_cap to all policy profiles.';
}

/**
 * Create the webhook delivery log table.
 */
function mcp_sentinel_update_10007(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('mcp_sentinel_webhook_delivery')) {
    return 'Webhook delivery log table already exists.';
  }
  $table = [
    'description' => 'Webhook delivery log for queued, retried MCP notifications.',
    'fields' => [
      'id'                 => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'endpoint_id'        => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'event_name'         => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'payload_hash'       => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'payload'            => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'status'             => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'pending'],
      'attempts'           => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_attempt'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'next_attempt'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'last_response_code' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'last_response_body' => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'created'            => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'item_id'            => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'status'       => ['status'],
      'next_attempt' => ['next_attempt'],
      'created'      => ['created'],
      'endpoint_id'  => ['endpoint_id'],
    ],
  ];
  $schema->createTable('mcp_sentinel_webhook_delivery', $table);
  return 'Created the mcp_sentinel_webhook_delivery table for reliable queued webhooks.';
}

/**
 * Migrate legacy single webhook endpoint into the webhook_endpoints sequence.
 */
function mcp_sentinel_update_10008(): string {
  $config = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
  if ($config->get('webhook_delivery_retention_days') === NULL) {
    $config->set('webhook_delivery_retention_days', 30);
  }
  if ($config->get('webhook_endpoints') === NULL) {
    $config->set('webhook_endpoints', []);
  }
  $legacy_url = (string) ($config->get('webhook_url') ?? '');
  if ($legacy_url !== '' && $config->get('webhook_endpoints') === []) {
    // allow_internal defaults FALSE for the migrated endpoint; operators can
    // opt-in per endpoint after migration if they need internal delivery.
    $config->set('webhook_endpoints', [
      [
        'id'             => 'default',
        'label'          => 'Default (migrated from legacy settings)',
        'url'            => $legacy_url,
        'secret_key'     => (string) ($config->get('webhook_secret_key') ?? ''),
        'events'         => [],
        'enabled'        => (bool) $config->get('webhook_enabled'),
        'allow_internal' => FALSE,
      ],
    ]);
  }
  // Backfill allow_internal=FALSE on any existing endpoints that predate this
  // migration (they will not have the key yet).
  $endpoints = (array) ($config->get('webhook_endpoints') ?? []);
  foreach ($endpoints as &$ep) {
    if (!array_key_exists('allow_internal', $ep)) {
      $ep['allow_internal'] = FALSE;
    }
  }
  unset($ep);
  $config->set('webhook_endpoints', $endpoints);
  // The global allow_internal_webhook_urls key is superseded by the
  // per-endpoint allow_internal flag; retain the value so it can be consulted
  // by operators during the transition, but it is no longer read by the worker.
  $config->save();
  return 'Migrated legacy webhook_url/webhook_secret_key to webhook_endpoints, '
    . 'added per-endpoint allow_internal flag (default FALSE). '
    . 'Legacy keys retained for review.';
}

/**
 * Add anomaly detection settings (all off by default; no rules enabled).
 */
function mcp_sentinel_update_10009(): string {
  $config = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
  $defaults = [
    'anomaly_enabled'       => FALSE,
    'anomaly_alert_email'   => '',
    'anomaly_alert_webhook' => FALSE,
    'anomaly_alert_log'     => TRUE,
    'anomaly_rules'         => [],
  ];
  foreach ($defaults as $key => $default) {
    if ($config->get($key) === NULL) {
      $config->set($key, $default);
    }
  }
  $config->save();
  return 'Added anomaly detection settings (all off by default). '
    . 'Configure rules at Configuration → Web services → MCP Sentinel.';
}

/**
 * Add allowed_ips field to existing policy profiles (empty = no restriction).
 */
function mcp_sentinel_update_10010(): string {
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    if ($e->get('allowed_ips') === NULL) {
      $e->set('allowed_ips', []);
      $e->save();
    }
  }
  return 'Added allowed_ips (default [] = no IP restriction) to all policy profiles.';
}

/**
 * Add config-governance + publish-gate fields to existing policy profiles.
 */
function mcp_sentinel_update_10011(): string {
  $defaults = [
    'allow_config_read' => FALSE,
    'allow_config_write' => FALSE,
    'denied_config_types' => [],
    'deny_publish' => TRUE,
    'max_moderation_state' => '',
  ];
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    $changed = FALSE;
    foreach ($defaults as $key => $value) {
      if ($e->get($key) === NULL) {
        $e->set($key, $value);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $e->save();
    }
  }
  return 'Added config-governance (allow_config_*, denied_config_types) and '
    . 'publish-gate (deny_publish, max_moderation_state) fields at safe '
    . 'defaults to all policy profiles.';
}

/**
 * Deny secret-, governance-, and credential-bearing entity types by default.
 *
 * Existing profiles denied only `user`. Profiles whose `allowed_entity_types`
 * is empty mean "allow all (minus the denylist)", so without this the agent
 * could read/write OAuth tokens, encryption keys, consumers, and the MCP
 * governance config itself. Additively merge a hardened denylist into every
 * profile (idempotent — only missing entries are appended; operator additions
 * are preserved).
 */
function mcp_sentinel_update_10012(): string {
  $hardened = [
    'user',
    'oauth2_token',
    'key',
    'consumer',
    'encryption_profile',
    'mcp_tool_config',
    'mcp_policy_profile',
  ];
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  $count = 0;
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    $current = $e->get('denied_entity_types') ?? [];
    $merged = array_values(array_unique([...$current, ...$hardened]));
    if ($merged !== $current) {
      $e->set('denied_entity_types', $merged)->save();
      $count++;
    }
  }
  return "Hardened denied_entity_types (secrets, governance config, credentials) "
    . "on {$count} policy profile(s).";
}

/**
 * Add the open-redirect guard fields to existing policy profiles.
 *
 * Backfills deny_external_redirects (default TRUE — secure by default) and
 * allowed_redirect_hosts (default [] — the site's own host(s)) on every profile
 * saved before the knob existed, so the gate is on without a re-save.
 */
function mcp_sentinel_update_10013(): string {
  $defaults = [
    'deny_external_redirects' => TRUE,
    'allowed_redirect_hosts' => [],
  ];
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    $changed = FALSE;
    foreach ($defaults as $key => $value) {
      if ($e->get($key) === NULL) {
        $e->set($key, $value);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $e->save();
    }
  }
  return 'Added open-redirect guard (deny_external_redirects, '
    . 'allowed_redirect_hosts) at safe defaults to all policy profiles.';
}

/**
 * Add the raw-SQL capability to existing policy profiles, off.
 *
 * Backfills allow_raw_sql = FALSE on every profile saved before the knob
 * existed. An upgrade must never hand an existing profile a capability it
 * never asked for, so this is written unconditionally at FALSE rather than
 * inferred from anything the site already has.
 */
function mcp_sentinel_update_10014(): string {
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  $count = 0;
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    if ($e->get('allow_raw_sql') === NULL) {
      $e->set('allow_raw_sql', FALSE)->save();
      $count++;
    }
  }
  return "Added allow_raw_sql (FALSE — raw SQL refused) to {$count} policy profile(s). "
    . 'Raw SQL now runs only through drush mcp-sentinel:sql-query, which enforces the '
    . 'profile and records every statement in the audit chain.';
}

/**
 * Add escape-hatch permission assertions to existing policy profiles.
 *
 * Writes the shipped forbidden list into every profile that predates the knob
 * so the protection is inherited without an operator authoring it, and seeds an
 * empty acknowledgement list. The list is written explicitly rather than left
 * to the entity's property default, so it is visible in config export and in
 * the config diff — an assertion nobody can see is one nobody reviews.
 */
function mcp_sentinel_update_10015(): string {
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  $count = 0;
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    $changed = FALSE;
    if ($e->get('forbidden_role_permissions') === NULL) {
      $e->set('forbidden_role_permissions', McpPolicyProfile::DEFAULT_FORBIDDEN_ROLE_PERMISSIONS);
      $changed = TRUE;
    }
    if ($e->get('acknowledged_role_permissions') === NULL) {
      $e->set('acknowledged_role_permissions', []);
      $changed = TRUE;
    }
    if ($changed) {
      $e->save();
      $count++;
    }
  }
  return "Added escape-hatch permission assertions to {$count} policy profile(s). "
    . 'Check Reports → Status report: a governed role that already holds one of these '
    . 'permissions is now reported as an error, and was previously invisible.';
}

/**
 * Move audit entries into the shared audit_chain table.
 *
 * Two things have to happen in this order, or the migrated rows stop
 * verifying:
 *
 *  1. The signing key and encryption profile move to audit_chain's settings
 *     first. The chain is keyed, so a row rehashed or read under a different
 *     key is indistinguishable from a tampered one.
 *  2. The rows are copied **verbatim** — prev_hash and row_hash exactly as
 *     written, and with an empty channel. They are NOT re-chained. Re-chaining
 *     would have been a one-line convenience and it would have destroyed the
 *     evidence: hashes recomputed by a migration prove only that the migration
 *     ran, and would silently repair a chain that had been broken beforehand.
 *     audit_chain omits the channel from the canonical payload when it is
 *     empty precisely so these rows keep verifying against their original
 *     hashes.
 *
 * Rows are copied in id order so the chain's sequence is preserved. The old
 * table is left in place for the operator to inspect and drop; this hook does
 * not delete anything it cannot recreate.
 */
function mcp_sentinel_update_10016(?array &$sandbox = NULL): string {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('mcp_sentinel_audit_log')) {
    return 'No legacy audit table to migrate.';
  }
  // Install audit_chain here rather than leaving it to update 10017.
  //
  // Update hooks run in ascending order, so 10017 — which exists precisely to
  // install this module — runs *after* this one. On the upgrade path that
  // motivated it (1.13 → 2.0 with audit_chain not yet enabled) this hook is
  // reached first, and throwing here meant 10017 never ran at all: the
  // self-healing update healed nothing in the one case it was written for.
  // A site with no legacy table returned above and never noticed.
  if (!\Drupal::moduleHandler()->moduleExists('audit_chain')) {
    \Drupal::service('module_installer')->install(['audit_chain']);
    $database = \Drupal::database();
  }
  if (!$database->schema()->tableExists('audit_chain_log')) {
    throw new UpdateException(
      'The audit_chain module must be installed before this update runs: its table holds the migrated entries. Installing it automatically did not produce the audit_chain_log table — enable the module manually (drush en audit_chain) and re-run database updates.'
    );
  }

  $sandbox ??= [];
  $sandbox += [
    'initialized' => FALSE,
    'last_legacy_id' => 0,
    'migrated' => 0,
    'total' => 0,
    '#finished' => 0,
  ];

  if (!$sandbox['initialized']) {
    $settings = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
    $chainSettings = \Drupal::configFactory()->getEditable('audit_chain.settings');
    $chainSettings
      ->set('hash_key', (string) ($settings->get('audit_hash_key') ?? ''))
      ->set('encryption_profile', (string) ($settings->get('audit_encryption_profile') ?? ''))
      ->set('stream_enabled', (bool) $settings->get('siem_enabled'))
      ->save();

    // Clear the copies left behind in mcp_sentinel.settings. Nothing reads them
    // after this migration, so leaving them is a silent no-op: an operator who
    // edits audit_hash_key in a config export (or a stale form default) would
    // believe they had rotated the signing key when they had not. The form
    // writes straight to audit_chain.settings; these keys must not exist here.
    $settings
      ->clear('audit_hash_key')
      ->clear('audit_encryption_profile')
      ->clear('siem_enabled')
      ->save();

    $sandbox['total'] = (int) $database->select('mcp_sentinel_audit_log', 'l')
      ->countQuery()
      ->execute()
      ->fetchField();
    $sandbox['initialized'] = TRUE;
    if ($sandbox['total'] === 0) {
      $sandbox['#finished'] = 1;
      return 'No legacy audit entries to migrate; copied audit-chain settings and cleared the moved keys from mcp_sentinel.settings.';
    }
  }

  $rows = $database->select('mcp_sentinel_audit_log', 'l')
    ->fields('l')
    ->condition('id', (int) $sandbox['last_legacy_id'], '>')
    ->orderBy('id', 'ASC')
    ->range(0, 200)
    ->execute();
  foreach ($rows as $row) {
    $row = (array) $row;
    $sandbox['last_legacy_id'] = (int) $row['id'];
    unset($row['id']);
    $database->insert('audit_chain_log')
      ->fields(['channel' => ''] + $row)
      ->execute();
    $sandbox['migrated']++;
  }

  $sandbox['#finished'] = min(1, $sandbox['migrated'] / $sandbox['total']);
  if ($sandbox['migrated'] >= $sandbox['total']) {
    $sandbox['#finished'] = 1;
    return "Migrated {$sandbox['migrated']} audit entries into audit_chain_log, verbatim and not re-chained, copied the signing key and encryption profile into audit_chain.settings, and cleared the moved keys from mcp_sentinel.settings. "
      . 'Run drush audit-chain:verify to confirm the chain still verifies, then drop mcp_sentinel_audit_log by hand once satisfied.';
  }

  return "Migrated {$sandbox['migrated']} of {$sandbox['total']} legacy audit entries into audit_chain_log.";
}

/**
 * Clear the audit settings left behind as silent no-ops after update 10016.
 *
 * 10016 copied audit_hash_key, audit_encryption_profile and siem_enabled into
 * audit_chain.settings but (before the clear step was added to 10016) left the
 * originals in mcp_sentinel.settings. Nothing reads them; the settings form
 * writes straight to audit_chain.settings. Editing the leftover keys — or a
 * config export that still contains them — is a silent no-op: the operator
 * believes they have rotated the signing key when they have not.
 *
 * Sites that already ran 10016 before the clear step need this hook. Sites
 * that have not yet run 10016 get the clear there and this becomes a no-op.
 *
 * Numbered 10018 (not 10017) so it lands cleanly alongside the sibling update
 * that installs audit_chain when the 2.0.0 upgrade left it disabled.
 */
function mcp_sentinel_update_10018(): string {
  $settings = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
  $cleared = [];
  foreach (['audit_hash_key', 'audit_encryption_profile', 'siem_enabled'] as $key) {
    if ($settings->get($key) !== NULL) {
      $settings->clear($key);
      $cleared[] = $key;
    }
  }
  if ($cleared === []) {
    return 'No leftover audit settings to clear from mcp_sentinel.settings.';
  }
  $settings->save();
  return 'Cleared silent no-op keys from mcp_sentinel.settings: ' . implode(', ', $cleared) . '. They live in audit_chain.settings now.';
}

/**
 * Install audit_chain if the 2.0.0 upgrade landed without it.
 *
 * 2.0.0 added audit_chain as a hard dependency, and the natural upgrade order
 * — `composer require drupal/mcp_sentinel:^2.0 && drush updatedb` — put the new
 * code on the site before anything could install it. The container then could
 * not compile (mcp_sentinel.audit_logger referenced a service that did not
 * exist), the front end returned 500, and drush could not be used to recover
 * because drush needs the same container. Rolling back made it worse: at 1.13
 * audit_chain is only a transitive requirement, so `composer require ^1.13`
 * removed it.
 *
 * The service reference is optional now, so the container builds and this hook
 * can run. Enabling the module here rather than only documenting the ordering
 * is the point: a required-dependency addition that bricks a site on the wrong
 * order is a landmine, and the error names a service rather than the module to
 * enable.
 *
 * This hook covers the sites 10016 returns early on — the ones with no legacy
 * `mcp_sentinel_audit_log` table to migrate. Sites that *do* have one reach
 * 10016 first, and update hooks run in ascending order, so 10016 installs
 * audit_chain itself rather than throwing past this hook. Both paths end up
 * with the module enabled; this one is not the only route to it.
 */
function mcp_sentinel_update_10017(): string {
  if (\Drupal::moduleHandler()->moduleExists('audit_chain')) {
    return 'The audit_chain module is already enabled.';
  }

  \Drupal::service('module_installer')->install(['audit_chain']);

  return 'Installed the audit_chain module, which MCP Sentinel requires to record audit entries.';
}

/**
 * Implements hook_uninstall().
 *
 * Only removes what core does not clean up automatically: the module's main
 * settings object and the 'mcp_api' role created on install. The hook_schema()
 * tables (webhook_delivery, content_locks) and the module's config entities
 * (policy profiles, and the approval submodule's request entity) are dropped by
 * core's uninstall machinery, so they are intentionally not handled here.
 *
 * The audit entries are deliberately NOT deleted. They live in audit_chain's
 * table now, which this module does not own — and an audit trail that erases
 * itself when the thing it was auditing is uninstalled is not an audit trail.
 * Remove them explicitly, or uninstall audit_chain, if that is really wanted.
 */
function mcp_sentinel_uninstall(): void {
  \Drupal::configFactory()->getEditable('mcp_sentinel.settings')->delete();
  // Remove the mcp_api role created on install.
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('mcp_api');
  if ($role) {
    $role->delete();
  }
}

/**
 * Seed the finite-by-default read-budget settings (#3616540).
 *
 * Sites installed before this feature have neither key in active config. The
 * resolver treats an absent require_finite_read_budgets as TRUE (the secure
 * default) and falls back to built-in constants for the default map, so
 * enforcement does not depend on this hook — it exists so active config states
 * the posture explicitly and a config export is clean rather than showing a
 * perpetual missing-key diff against config/install.
 */
function mcp_sentinel_update_10019(): string {
  $settings = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
  $added = [];
  if ($settings->get('require_finite_read_budgets') === NULL) {
    $settings->set('require_finite_read_budgets', TRUE);
    $added[] = 'require_finite_read_budgets=true';
  }
  if ($settings->get('read_budget_defaults') === NULL) {
    $settings->set('read_budget_defaults', [
      'results' => 500,
      'bytes' => 8388608,
      'requests' => 600,
      'request_window' => 60,
      'pages' => 120,
      'page_window' => 60,
    ]);
    $added[] = 'read_budget_defaults (500 results, 8 MiB, 600 req/60 s, 120 pages/60 s)';
  }
  if ($added === []) {
    return 'Read-budget settings already present; nothing to seed.';
  }
  $settings->save();
  return 'Seeded finite-by-default read budgets: ' . implode('; ', $added) . '. Set require_finite_read_budgets to false only as an explicit non-production override.';
}

/**
 * Add the evidence-required action list to existing policy profiles, empty.
 *
 * Backfills evidence_required_actions = [] on every profile saved before the
 * knob existed, so exported configuration round-trips without drift. Empty on
 * purpose: an upgrade must never opt an existing profile into the
 * evidence-required veto it never asked for.
 */
function mcp_sentinel_update_10020(): string {
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  $count = 0;
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    if ($e->get('evidence_required_actions') === NULL) {
      $e->set('evidence_required_actions', [])->save();
      $count++;
    }
  }
  return "Added evidence_required_actions (empty - veto off) to {$count} policy profile(s). "
    . 'Listing entity_write or entity_delete on a profile makes those governed actions '
    . 'execute only when their evidence can commit to the keyed audit chain (#3616539).';
}

/**
 * Seed the classification vocabulary and map; backfill empty egress ceilings.
 *
 * Part 2 of d.o #3616540. Settings gain the ordered classification vocabulary
 * (public < internal < restricted), the global classification map (the
 * identity/credential types the default profile already denies, labelled
 * restricted), and the label of the context schema document. Every existing
 * policy profile gets an EMPTY egress_ceilings map so exported configuration
 * round-trips without drift. Empty on purpose: an absent ceiling is no
 * ceiling, so an upgrade changes no read decision until an operator sets one.
 */
function mcp_sentinel_update_10021(): string {
  $settings = \Drupal::configFactory()->getEditable('mcp_sentinel.settings');
  $added = [];
  if ($settings->get('classification_labels') === NULL) {
    $settings->set('classification_labels', ['public', 'internal', 'restricted']);
    $added[] = 'classification_labels (public < internal < restricted)';
  }
  if ($settings->get('classification_map') === NULL) {
    $map = [];
    foreach (['user', 'oauth2_token', 'key', 'consumer', 'encryption_profile'] as $type) {
      $map[] = ['entity_type' => $type, 'bundle' => '', 'field' => '', 'label' => 'restricted'];
    }
    $settings->set('classification_map', $map);
    $added[] = 'classification_map (identity/credential types labelled restricted)';
  }
  if ($settings->get('context_schema_label') === NULL) {
    $settings->set('context_schema_label', 'internal');
    $added[] = 'context_schema_label=internal';
  }
  if ($added !== []) {
    $settings->save();
  }

  $count = 0;
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('mcp_policy_profile')
    ->loadMultiple();
  foreach ($profiles as $profile) {
    $e = \Drupal::configFactory()
      ->getEditable('mcp_sentinel.mcp_policy_profile.' . $profile->id());
    if ($e->get('egress_ceilings') === NULL) {
      $e->set('egress_ceilings', [])->save();
      $count++;
    }
  }

  $settingsPart = $added === []
    ? 'Classification settings already present; nothing to seed.'
    : 'Seeded classification settings: ' . implode('; ', $added) . '.';
  return $settingsPart . " Added egress_ceilings (empty - no ceiling) to {$count} policy profile(s). "
    . 'Set per-surface ceilings on a profile to enforce classification-aware egress (#3616540).';
}
